<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <title>Хеширование SHA-256</title>
    <style>
        body { font-family: sans-serif; padding: 20px; }
        textarea, input { width: 100%; padding: 8px; margin-bottom: 10px; box-sizing: border-box; }
        button { padding: 8px 16px; cursor: pointer; }
        #result { background: #f5f5f5; padding: 10px; font-family: monospace; word-break: break-all; }
    </style>
</head>
<body>
    <h2>Хеширование (SHA-256)</h2>
    <textarea id="input" rows="4" placeholder="Введите текст для хеширования..."></textarea>
    <button onclick="hash()">Получить хеш</button>
    <div><strong>Результат:</strong></div>
    <div id="result"></div>

    <script>
        async function hash() {
            const text = document.getElementById('input').value;
            const resultDiv = document.getElementById('result');

            if (!text) {
                resultDiv.textContent = 'Введите текст!';
                return;
            }

            try {
                const msgBuffer = new TextEncoder().encode(text);
                const hashBuffer = await crypto.subtle.digest('SHA-256', msgBuffer);
                const hashArray = Array.from(new Uint8Array(hashBuffer));
                const hashHex = hashArray.map(b => b.toString(16).padStart(2, '0')).join('');

                resultDiv.textContent = hashHex;
            } catch (e) {
                resultDiv.textContent = 'Ошибка: ' + e.message;
            }
        }
    </script>
</body>
</html>
